# API: leave empty to use relative /api (Vite proxy → Flask in local dev)
VITE_API_BASE=

# Demo banner in UI (catalog shows real prices; charge is $0.01)
VITE_DEMO_MODE=true

# Firebase web config (fill after `firebase apps:sdkconfig WEB` on rosaseternas-mvp)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=rosaseternas-mvp
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
