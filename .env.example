# App
APP_NAME=Rosas Eternas
DEMO_MODE=true
MAX_AMOUNT_MXN=1.00

# Payment provider (server-only — never expose to frontend)
PEY_API_KEY=
PEY_WEBHOOK_SECRET=
PEY_API_BASE=https://api.pey.mx
# Optional; omit QR bankAccountId unless set
BANK_ACCOUNT_ID=

# Firebase / GCP (ADC on Cloud Run; local: gcloud auth application-default login)
GOOGLE_CLOUD_PROJECT=rosaseternas-mvp
FIRESTORE_PROJECT_ID=rosaseternas-mvp

# Frontend (copy relevant lines into frontend/.env — see frontend/.env.example)
# VITE_API_BASE=
# VITE_DEMO_MODE=true
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=rosaseternas-mvp
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
